{
  "ignorePatterns": ["cdk.out/", "coverage/", "lib/**/*.js", "bin/*.js", "dist"],
  "env": {
    "browser": false,
    "es2021": true,
    "node": true
  },
  "extends": [
    "airbnb-base",
    "prettier",
    "plugin:@typescript-eslint/recommended", // Add TypeScript support
    "plugin:promise/recommended",
    "plugin:sonarjs/recommended"
  ],
  "parser": "@typescript-eslint/parser", // Add TypeScript parser
  "plugins": [
    "prettier",
    "@typescript-eslint", // Add TypeScript plugin
    "promise",
    "sonarjs",
    "unicorn"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.base.json" // Point to your tsconfig
  },
  "rules": {
    "prettier/prettier": "error",
    "import/prefer-default-export": "off",
    "no-await-in-loop": "off",
    "camelcase": "off",
    "no-empty": "off",
    "import/extensions": [
      // Handle TypeScript imports
      "error",
      "ignorePackages",
      {
        "ts": "never",
        "tsx": "never"
      }
    ],

    // --- Complexity budgets (mirrors ms-argus-api) ---------------------------------
    // These hold the *public* wrappers honest. The primitive kernel is exempted below:
    // a SHA-512 compression function or an AES round is legitimately long and branchy,
    // and splitting it to appease a counter would make it harder to audit against the spec.
    "complexity": ["error", 12],
    "max-depth": ["error", 4],
    "max-lines-per-function": ["error", { "max": 60, "skipBlankLines": true, "skipComments": true }],
    "max-params": ["error", 6],
    "max-nested-callbacks": ["error", 3],
    "sonarjs/cognitive-complexity": ["error", 12],
    "unicorn/no-useless-undefined": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/no-lonely-if": "error"
  },
  "settings": {
    "import/resolver": {
      // Help ESLint resolve TypeScript imports
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "tests/**/*.ts"], // Add TypeScript files pattern
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.base.json"
      }
    },
    {
      // The pure-JS crypto kernel. Bit twiddling and index loops are the point here, not
      // a style lapse: these files implement block ciphers, hash compression functions and
      // field arithmetic, which the specs define in exactly those terms.
      "files": ["src/crypto/primitives/**/*.ts"],
      "rules": {
        "no-bitwise": "off",
        "no-plusplus": "off",
        "no-continue": "off",
        "no-restricted-syntax": "off",
        // Block ciphers and GHASH transform a state buffer in place. Allocating a fresh
        // array per round would be pure waste, so mutating the parameter is the design.
        "no-param-reassign": "off",
        "prefer-destructuring": "off",
        // A hash compression function or a curve ladder is inherently long and branchy.
        // The spec is the readability contract here, not a line/complexity counter, so the
        // budgets that guard the wrappers are relaxed for the kernel -- but never turned into
        // a free-for-all: correctness rules (no-unused, promises, etc.) stay on.
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off",
        "sonarjs/cognitive-complexity": "off",
        "max-statements": "off"
      }
    },
    {
      "files": ["tests/**"],
      "plugins": ["jest"],
      "extends": ["plugin:jest/recommended"],
      "rules": {
        "import/no-extraneous-dependencies": ["error", { "devDependencies": true }],
        "no-bitwise": "off",
        "no-restricted-syntax": "off",
        "no-await-in-loop": "off",
        // describe/test trees are legitimately long, deep and repetitive; the complexity
        // budgets target production code, not the specs that exercise it.
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off",
        "sonarjs/cognitive-complexity": "off",
        "sonarjs/no-duplicate-string": "off",
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      "files": ["lib/**"],
      "rules": {
        "import/no-extraneous-dependencies": ["error", { "devDependencies": false }]
      }
    }
  ]
}
